{
  "name": "emacsthemes",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "bun test",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "bun src/core/validate.ts",
    "screenshots": "sh src/docker/run.sh",
    "build": "bun src/templates/build.ts",
    "cf:init": "ln -sf src/cloudflare/functions ./functions",
    "cf:deploy": "bun run cf:init && rm -rf build/static/imgs && bunx wrangler pages deploy build",
    "deploy:imgs": "bun src/cloudflare/upload-imgs-to-r2.ts",
    "deploy": "bun run deploy:imgs && bun run cf:deploy",
    "dev": "bun run cf:init && bunx wrangler pages dev build --binding ENVIRONMENT=development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emacs-themes/emacsthemes.git"
  },
