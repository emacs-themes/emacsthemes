  },
  "homepage": "https://github.com/emacs-themes/emacsthemes#readme",
  "dependencies": {
    "html-minifier-terser": "^7.2.0",
    "wrangler": "^4.65.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260217.0",
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.5",
    "@types/html-minifier-terser": "^7.0.2",
    "eslint": "^9.39.2",
