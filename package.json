{
  "name": "emacsthemes",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/emacs-themes/emacsthemes#readme",
  "bugs": {
    "url": "https://github.com/emacs-themes/emacsthemes/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emacs-themes/emacsthemes.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit && bun run fmt:check && bun run lint && bun run lint:css",
    "convert:theme-imgs": "bun src/scripts/convert-theme-imgs-to-webp.ts",
    "lint:css": "stylelint **/*.css",
    "lint:css:fix": "bun run lint:css -- --fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "validate": "bun src/core/validate.ts",
    "screenshots": "sh src/docker/run.sh",
    "preview": "bun run build && bun run dev",
    "build": "bun src/templates/build.ts",
    "deploy:site": "rm -rf build/static/imgs && bun wrangler pages deploy build --project-name=emacsthemes --branch=main",
    "deploy:imgs": "bun src/cloudflare/upload-imgs-to-r2.ts",
    "deploy:delete-oldest": "bun src/cloudflare/delete-oldest-deployment.ts",
    "deploy": "bun run deploy:imgs && bun run deploy:site",
    "dev": "bun --watch src/templates/build.ts & bun wrangler pages dev build --live-reload --binding ENVIRONMENT=development"
  },
  "dependencies": {
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.32.0",
    "wrangler": "^4.83.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260416.2",
    "@types/bun": "^1.3.12",
    "@types/html-minifier-terser": "^7.0.2",
    "globals": "^17.5.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "stylelint": "^17.8.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.2"
  }
}
